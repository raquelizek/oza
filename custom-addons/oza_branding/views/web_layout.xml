<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" inherit_id="web.layout" name="OZA Layout">
        <xpath expr="//title" position="replace">
            <title>OZA塾管理システム</title>
        </xpath>

        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="icon" type="image/png" href="/oza_theme/static/src/img/oza_logo.png"/>
            <link rel="shortcut icon" type="image/png" href="/oza_theme/static/src/img/oza_logo.png"/>
        </xpath>

        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/png" href="/oza_branding/static/src/img/favicon.png"/>
            <link rel="shortcut icon" type="image/png" href="/oza_branding/static/src/img/favicon.png"/>
        </xpath>
    </template>

    <template id="oza_login_layout" inherit_id="web.login_layout" name="Login Layout" priority="1000">
        <xpath expr="t" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'bg-100'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <div class="container py-5">
                    <div class="card border-0 mx-auto bg-100 o_database_list" style="max-width: 300px;">
                        <div class="card-body">
                            <div class="text-center pb-3 border-bottom mb-4">
                                <img t-att-src="'/oza_branding/static/src/img/logo.png'" alt="OZA塾管理システム" style="max-height:120px; max-width: 100%; width:auto"/>
                            </div>

                            <t t-out="0"/>

                            <div class="text-center small pt-3 border-top" t-if="not disable_footer">
                                <t t-if="not disable_database_manager">
                                    <a class="pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>