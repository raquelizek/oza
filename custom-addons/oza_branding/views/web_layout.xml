<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" inherit_id="web.layout" name="OZA Layout">
        <xpath expr="//title" position="replace">
            <title>OZA塾管理システム</title>
        </xpath>

        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="icon" type="image/png" href="/oza_theme/static/src/img/oza_logo.png"/>
            <link rel="shortcut icon" type="image/png" href="/oza_theme/static/src/img/oza_logo.png"/>
        </xpath>
        
        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/png" href="/oza_branding/static/src/img/favicon.png"/>
            <link rel="shortcut icon" type="image/png" href="/oza_branding/static/src/img/favicon.png"/>
        </xpath>
    </template>

</odoo>